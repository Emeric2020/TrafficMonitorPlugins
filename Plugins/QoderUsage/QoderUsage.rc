#include <windows.h>
#include "OptionsResource.h"

IDD_QODER_OPTIONS DIALOGEX 0, 0, 310, 190
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Qoder Usage options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Refresh interval", IDC_QODER_POLL_LABEL, 12, 10, 100, 12
    COMBOBOX        IDC_QODER_POLL, 120, 8, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Low-quota alert", IDC_QODER_ALERT_LABEL, 12, 34, 100, 12
    COMBOBOX        IDC_QODER_ALERT, 120, 32, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Taskbar > Display settings: select two of Qoder, QoderCN, WorkBuddy and WorkBuddyCN.\r\nTurn off horizontal arrangement to stack the two items. Bars show remaining credits, using pale green, yellow and red as the balance falls.", IDC_QODER_HINT, 12, 66, 286, 82
    DEFPUSHBUTTON   "OK", IDOK, 130, 164, 76, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 216, 164, 82, 14
END
